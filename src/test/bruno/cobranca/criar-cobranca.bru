meta {
  name: Criar Cobranca Mercado Pago
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cobrancas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pedidoId": "{{ordemServicoId}}",
    "descricao": "Pagamento da Ordem de Servico {{ordemServicoId}}",
    "valor": {{valorTotal}}
  }
}

script:pre-request {
  if (!bru.getEnvVar("valorTotal")) {
    bru.setEnvVar("valorTotal", "485.00");
  }
}

script:post-response {
  const resBody = res.getBody();
  if (resBody && resBody.cobrancaId) {
    bru.setEnvVar("cobrancaId", resBody.cobrancaId);
    bru.setEnvVar("linkPagamento", resBody.linkPagamento || "");
    bru.setEnvVar("referencia", resBody.referencia || "");
  }
}
