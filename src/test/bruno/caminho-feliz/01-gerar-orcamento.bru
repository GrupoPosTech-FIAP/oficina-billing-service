meta {
  name: 01 - Gerar Orcamento
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orcamentos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ordemServicoId": "{{ordemServicoId}}",
    "clienteId": "{{clienteId}}",
    "observacoes": "Revisão periódica preventiva de 50.000 km",
    "itens": [
      {
        "descricao": "Óleo Sintético 5W30 (Litro)",
        "quantidade": 4,
        "precoUnitario": 45.00
      },
      {
        "descricao": "Filtro de Óleo",
        "quantidade": 1,
        "precoUnitario": 35.00
      },
      {
        "descricao": "Jogo de Pastilhas de Freio Dianteiro",
        "quantidade": 1,
        "precoUnitario": 120.00
      },
      {
        "descricao": "Mão de Obra de Manutenção e Substituição",
        "quantidade": 1,
        "precoUnitario": 150.00
      }
    ]
  }
}

script:pre-request {
  function gerarUUID() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }

  // Gera novo UUID para a OS caso queira rodar o fluxo completo repetidas vezes
  const osId = gerarUUID();
  bru.setEnvVar("ordemServicoId", osId);

  const cliId = bru.getEnvVar("clienteId") || gerarUUID();
  bru.setEnvVar("clienteId", cliId);
}

script:post-response {
  const resBody = res.getBody();
  if (resBody && resBody.id) {
    bru.setEnvVar("orcamentoId", String(resBody.id));
    bru.setEnvVar("valorTotal", String(resBody.valorTotal));
  }
}
